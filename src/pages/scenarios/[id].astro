---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { label } from '../../lib/taxonomy';
import { isPublished } from '../../lib/publish';
import { existsSync, statSync } from 'node:fs';
import { join } from 'node:path';
import ToolIcon from '../../components/ToolIcon.astro';

export async function getStaticPaths() {
  const items = await getCollection('scenarios', (s) => isPublished(s.data.status, s.data.publish_draft));
  return items.map((s) => ({ params: { id: s.data.id }, props: { s } }));
}
const { s } = Astro.props;
const d = s.data;
const { Content, headings } = await render(s);
const stepsId = headings.find(heading => heading.text.toLowerCase() === 'steps')?.slug ?? 'scenario-steps';
const base = import.meta.env.BASE_URL;
const kitPath = join(process.cwd(), 'public', 'kits', `${d.id}.zip`);
const kit = d.demo_kit && existsSync(kitPath) ? { href: `${base}kits/${d.id}.zip`, kb: Math.round(statSync(kitPath).size / 1024) } : null;
---
<Base title={d.title.en} scenario>
  <p class="crumb"><a id="back-to-results" href={`${base}?view=all`} data-base={base}>&larr; All scenarios</a> / {label('industry', d.industry[0])}</p>
  <div class="page">
    <article data-pagefind-body>
      <h1 data-pagefind-meta="title"><span data-l="en">{d.title.en}</span><span data-l="id">{d.title.id}</span><span data-l="ms">{d.title.ms}</span></h1>
      <div class="tags">
        <span class="chip lvl">{label('difficulty', d.difficulty)}</span>
        {d.industry.map((x) => <a class="chip" href={`${base}?industry=${x}`}>{label('industry', x)}</a>)}
        {d.department.map((x) => <a class="chip" href={`${base}?department=${x}`}>{label('department', x)}</a>)}
        {d.persona.map((x) => <a class="chip" href={`${base}?persona=${x}`}>{label('persona', x)}</a>)}
        {d.surface.map((x) => <a class="chip tool-chip" href={`${base}?surface=${x}`}><ToolIcon tool={x}/>{label('surface', x)}</a>)}
        {d.market.map((x) => <span class="chip">{label('market', x)}</span>)}
      </div>
      {d.status === 'draft' && (
        <p class="validation-note"><strong>Draft · tenant validation pending.</strong> {d.validation_note}</p>
      )}

      <section class="card60">
        <div class="k">At a glance</div>
        <div class="grid60">
          <div><b>Problem</b><p>{d.card.problem}</p></div>
          <div><b>You get</b><p>{d.card.output}</p></div>
          <div><b>Time</b><p>{d.impact.baseline} → {d.impact.target}<br /><span class={`chip ev-${d.impact.evidence}`}>{label('evidence', d.impact.evidence)}</span></p></div>
        </div>
      </section>

      <div class="quick-start">
        {kit && <a class="start-kit" href={kit.href} download>&darr; Download demo kit <span>{kit.kb} KB</span></a>}
        <a class="start-go" id="start-step1" href={`#${stepsId}`}>Start at step 1 <span aria-hidden="true">&darr;</span></a>
        <label class="presenting"><input type="checkbox" id="presenting" /> I'm presenting: show session notes</label>
      </div>
      <div class="prose" id="scenario-steps"><Content /></div>
      <footer class="sources">
        <b>Sources:</b> {d.source_refs.map((u, i) => <>{i > 0 && ' · '}<a href={u}>{new URL(u).hostname}</a></>)}
        {d.validated_on && <span> · Validated {d.validated_on.toISOString().slice(0, 7)} · {d.demo_kit ? 'fictional data' : 'tested in a demo tenant'}</span>}
      </footer>
    </article>

    <aside class="side">
      {kit && (
        <a class="kit" href={kit.href} download>
          <strong>Download demo kit</strong>
          <span>Fictional files, answer key and setup notes · {kit.kb} KB</span>
        </a>
      )}
      <nav class="onthispage" aria-labelledby="otp-h">
        <div class="k" id="otp-h">On this page</div>
        <ul>
          {headings.filter((h) => h.depth >= 2 && h.depth <= 4 && !['files', 'heads-up'].includes(h.slug)).map((h) => (
            <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </nav>
      <div class="box datarules">
        <div class="k">Data rules</div>
        <p><strong>Sensitivity:</strong> {d.data.sensitivity}</p>
        <p><strong>Personal data:</strong> {d.data.customer_pii ? 'Yes' : 'No'}</p>
        <p><strong>Approval before use:</strong> {d.data.signoff}</p>
        <p class="tenant">Work account only. Never a consumer AI tool.</p>
      </div>
    </aside>
  </div>
</Base>

<script>
  const header = document.querySelector<HTMLElement>('.top');
  if (header) {
    const updateAnchorOffset = () => document.documentElement.style.setProperty('--scenario-anchor-offset', `${Math.ceil(header.getBoundingClientRect().height) + 16}px`);
    updateAnchorOffset();
    new ResizeObserver(updateAnchorOffset).observe(header);
  }
  const back = document.getElementById('back-to-results');
  const query = new URLSearchParams(location.search).get('library');
  if (back instanceof HTMLAnchorElement && query) {
    const params = new URLSearchParams(query);
    back.href = `${back.dataset.base}?${params}`;
    back.textContent = params.get('view') === 'recommended' ? '\u2190 Back to your suggestions' : '\u2190 Back to results';
  }
  const start = document.getElementById('start-step1');
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-select-tier]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-tier-content]')];
  const updateStart = () => {
    const step = document.querySelector<HTMLElement>('[data-tier-section="steps"]:not([hidden]) .stepcard') ?? document.getElementById('step-1');
    if (start instanceof HTMLAnchorElement && step) start.href = `#${step.id}`;
  };
  const selectTier = (key: string) => {
    if (!tabs.some((tab) => tab.dataset.selectTier === key)) return;
    panels.forEach((panel) => { panel.hidden = panel.dataset.tierContent !== key; });
    tabs.forEach((tab) => {
      const selected = tab.dataset.selectTier === key;
      tab.setAttribute('aria-selected', String(selected));
      tab.tabIndex = selected ? 0 : -1;
    });
    document.querySelectorAll<HTMLAnchorElement>('.onthispage a').forEach((link) => {
      const target = document.getElementById(link.hash.slice(1));
      const panel = target?.closest<HTMLElement>('[data-tier-content]');
      const item = link.closest('li');
      if (item) item.hidden = Boolean(panel?.hidden);
    });
    updateStart();
  };
  const selectFromHash = () => {
    const target = document.getElementById(location.hash.slice(1));
    const panel = target?.closest<HTMLElement>('[data-tier-content]');
    const key = panel?.dataset.tierContent;
    if (key) {
      selectTier(key);
      requestAnimationFrame(() => target?.scrollIntoView({ block: 'start' }));
    }
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => {
      selectTier(tab.dataset.selectTier!);
      if (location.hash) history.replaceState(history.state, '', `${location.pathname}${location.search}`);
    });
    tab.addEventListener('keydown', (event) => {
      const indices: Record<string, number> = {
        ArrowRight: (index + 1) % tabs.length, ArrowLeft: (index + tabs.length - 1) % tabs.length,
        Home: 0, End: tabs.length - 1,
      };
      if (!(event.key in indices)) return;
      event.preventDefault();
      tabs[indices[event.key]].click();
      tabs[indices[event.key]].focus();
    });
  });
  if (tabs.length) {
    selectTier(tabs[0].dataset.selectTier!);
    selectFromHash();
    window.addEventListener('hashchange', selectFromHash);
  } else updateStart();
  // Step "Done" toggles and the Check-it ticks are remembered per scenario in this browser only.
  const page = location.pathname;
  const load = (k: string): unknown[] => { try { return JSON.parse(localStorage.getItem(k) || '[]'); } catch { return []; } };
  const save = (k: string, v: unknown[]) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} };
  const doneKey = `sl:${tabs.length ? 'v2' : 'v1'}:done:${page}`;
  const done = new Set(load(doneKey) as string[]);
  const tick = (n: string) => {
    const on = done.has(n);
    document.querySelectorAll(`.done[data-step="${n}"]`).forEach((b) => { b.setAttribute('aria-pressed', String(on)); b.textContent = on ? '\u2713 Done' : 'Done'; b.closest('.stepcard')?.classList.toggle('is-done', on); });
    document.querySelectorAll(`.onthispage a[href="#step-${n}"]`).forEach((a) => a.classList.toggle('is-done', on));
  };
  document.querySelectorAll<HTMLButtonElement>('.done').forEach((b) => {
    const n = b.dataset.step ?? ''; tick(n);
    b.addEventListener('click', () => { if (done.has(n)) done.delete(n); else done.add(n); save(doneKey, [...done]); tick(n); });
  });
  const checkKey = `sl:${tabs.length ? 'v2' : 'v1'}:check:${page}`;
  const checks = load(checkKey) as number[];
  const boxes = [...document.querySelectorAll<HTMLInputElement>('.checklist .chk')];
  boxes.forEach((c, i) => {
    c.checked = checks.includes(i);
    c.addEventListener('change', () => save(checkKey, boxes.flatMap((x, j) => (x.checked ? [j] : []))));
  });
  const presenting = document.getElementById('presenting');
  const notes = document.querySelector('details.presenter');
  if (presenting instanceof HTMLInputElement && notes instanceof HTMLDetailsElement) {
    presenting.checked = notes.open;
    presenting.addEventListener('change', () => { notes.open = presenting.checked; });
    notes.addEventListener('toggle', () => { presenting.checked = notes.open; });
  } else presenting?.closest('label')?.remove();
</script>

<style>
  .crumb { font-size:13px; color:var(--ink2); margin:0 0 24px }
  .kit { display:block; padding:0 0 20px; border-bottom:1px solid var(--line); color:var(--brand); text-decoration:none }
  .kit:hover strong { text-decoration:underline } .kit strong { display:block; font-size:15px } .kit span { display:block; margin-top:4px; font-size:12.5px; color:var(--ink2) }
  .page { display:grid; grid-template-columns:minmax(0, 1fr) 228px; gap:52px; align-items:start }
  article { background:transparent; border:0; border-radius:0; padding:0; min-width:0 }
  h1 { margin:0 0 18px; font-size:clamp(30px, 3vw, 38px); line-height:1.18; letter-spacing:-.03em; font-weight:600 }
  .tags { display:flex; flex-wrap:wrap; align-items:center; gap:7px 12px }
  .tags .chip { display:inline-flex; align-items:center; min-height:26px; margin:0; padding:0; border-radius:0; background:transparent; font-size:12.5px }
  .tags .chip.lvl { padding:2px 7px; border-radius:4px; background:var(--brand-soft); color:var(--brand) }
  .tags a.chip { text-decoration:none } .tags a.chip:hover { color:var(--cp-accent); text-decoration:underline }
  .validation-note { margin:20px 0; padding:12px 16px; border-left:3px solid var(--warnline); background:var(--cp-bg-elevated); font-size:13px; color:var(--ink2) }
  .card60 { margin:30px 0 24px; background:var(--cp-bg-elevated); border:1px solid var(--line); border-radius:8px; padding:18px 22px }
  .grid60 { display:grid; grid-template-columns:1fr 1.3fr .9fr; gap:24px } .grid60 p { margin:5px 0 0; font-size:14px; line-height:1.55; color:var(--ink2) }
  .grid60 b { font-size:14px; font-weight:600 }
  .grid60 .chip { margin-top:7px; font-size:11px }
  .k { font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.07em; color:var(--ink2); margin:0 0 12px }
  .prose :global(h2) { font-size:25px; font-weight:600; margin:44px 0 16px; padding:0; border:0; letter-spacing:-.02em; line-height:1.3 }
  .prose :global(h3) { font-size:20px; font-weight:600; margin:30px 0 12px; line-height:1.35 } .prose :global(h4) { font-size:18px; font-weight:600; line-height:1.4; margin:0 }
  /* Keep running text at a readable measure; cards and tables use the full column. */
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(.callout) { max-width:72ch }
  .prose :global(.prompt .plines), .prose :global(.prompt .ptext), .prose :global(.prompt .pabout) { max-width:none }
  .prose :global(.stepcard) { max-width:none; border:1px solid var(--line); border-radius:8px; background:var(--cp-surface); padding:18px 20px; margin:20px 0 28px }
  .prose :global(.stephead) { display:flex; align-items:flex-start; gap:10px; margin-bottom:12px }
  .prose :global(.stephead .num) { flex:none; width:28px; height:28px; border-radius:6px; background:var(--brand-soft); color:var(--brand); font-weight:600; font-size:14px; line-height:28px; text-align:center }
  .prose :global(.do) { margin:0 0 12px }
  .prose :global(.stepcard > p:last-child) { margin-bottom:0 }
  .prose :global(.after-run) { background:transparent; border-left:2px solid var(--cp-success); border-radius:0; padding:0 0 0 12px; margin:16px 0 0; font-size:14px; color:var(--ink2) }
  .prose :global(h3.part) { padding-top:20px; border-top:1px solid var(--line); color:var(--ink) }
  .prose :global(.part-note) { margin-top:-4px; color:var(--cp-text-muted) }
  .side { position:sticky; top:var(--scenario-anchor-offset, 104px); display:flex; flex-direction:column; gap:24px; padding:18px; border:1px solid var(--line); border-radius:8px; background:var(--cp-bg-elevated); max-height:calc(100dvh - var(--scenario-anchor-offset, 104px) - 16px); overflow-y:auto; scrollbar-width:thin }
  .side > * { flex-shrink:0 }
  .box { background:transparent; border:0; border-radius:0; padding:0 }
  .datarules { padding-top:20px; border-top:1px solid var(--line) } .datarules .tenant { margin-top:10px; font-weight:600; font-size:12.5px }
  .onthispage { background:transparent; border:0; border-radius:0; padding:0; min-height:0 }
  /* Long navigation stays inside the sidebar box without a second scrollbar. */
  .onthispage ul { list-style:none; margin:0; padding:0; font-size:13.5px }
  .onthispage li { padding:4px 0 } .onthispage a { text-decoration:none; color:var(--cp-text-muted) }
  .onthispage a:hover { color:var(--cp-accent); text-decoration:underline }
  .onthispage .d2 > a { font-weight:600; color:var(--ink) } .onthispage .d3 { padding-left:10px } .onthispage .d4 { padding-left:20px; font-size:13px }
  .box p { margin:0 0 8px; font-size:12.5px; line-height:1.5; color:var(--ink2) } .src { font-size:13px !important; overflow-wrap:anywhere }
  .quick-start { display:flex; align-items:center; gap:14px; margin:24px 0 36px; font-size:13px; flex-wrap:wrap; padding:0; background:transparent; border:0; border-radius:0 }
  .start-kit, .start-go { display:inline-flex; align-items:center; gap:8px; text-decoration:none; border-radius:6px; padding:9px 14px; font-size:14px; font-weight:600; min-height:44px; border:1px solid transparent }
  .start-kit { background:var(--brand); color:var(--cp-accent-fg) } .start-kit:hover { background:var(--cp-accent-hover) } .start-kit span { font-weight:400; font-size:12px; opacity:.85 }
  .start-go { background:transparent; color:var(--brand); padding-inline:0 } .start-go:hover { text-decoration:underline }
  .start-note { color:var(--cp-text-muted) }
  .prose { overflow-wrap:anywhere; scroll-margin-top:var(--scenario-anchor-offset, 104px) }
  .prose :global(table) { display:block; max-width:100%; overflow:auto }
  .prose :global(th), .prose :global(td) { border:0; border-bottom:1px solid var(--line); padding:10px 12px }
  .prose :global(th) { background:transparent; font-weight:600; border-bottom-width:2px }
  .prose :global(img) { max-width:100%; height:auto }
  .prose :global(pre) { max-width:100%; overflow:auto }
  .prose :global(h2), .prose :global(h3), .prose :global(h4) { scroll-margin-top:var(--scenario-anchor-offset, 104px) }
  .prose :global(.stepcard) { scroll-margin-top:var(--scenario-anchor-offset, 104px) }
  .presenting { display:inline-flex; align-items:center; gap:8px; color:var(--cp-text-muted); cursor:pointer; font-size:12.5px }
  .sources { margin-top:28px; padding-top:12px; border-top:1px solid var(--line); font-size:12.5px; color:var(--cp-text-muted) } .sources a { color:inherit }
  /* Objective and situation */
  .prose :global(.objective) { max-width:72ch; background:transparent; border:0; border-radius:0; padding:0; margin:0 0 24px }
  .prose :global(.objective-k) { font-size:11px; font-weight:600; letter-spacing:.07em; text-transform:uppercase; color:var(--ink2) }
  .prose :global(.objective p) { margin:7px 0 0; font-size:18px; line-height:1.6; font-weight:500 }
  /* Before you start */
  .prose :global(.start-grid) { display:grid; grid-template-columns:minmax(0, 1fr); gap:14px; margin:12px 0 16px }
  .prose :global(.start-grid > *) { margin:0; max-width:none }
  .prose :global(.needs) { border:1px solid var(--line); border-radius:8px; padding:16px 20px; background:var(--cp-bg-elevated) }
  .prose :global(.needs-k) { font-weight:600; color:var(--ink); margin-bottom:12px }
  .prose :global(.app-icon) { width:24px; height:24px; flex:0 0 24px; object-fit:contain }
  .prose :global(.needs dl) { margin:0; display:grid; gap:10px }
  .prose :global(.need) { display:grid; grid-template-columns:80px 1fr; gap:10px; align-items:baseline }
  .prose :global(.need dt) { font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:var(--ink2) } .prose :global(.need dd) { margin:0 }
  .prose :global(.also) { display:block } .prose :global(.also + .also) { margin-top:3px }
  .prose :global(.needs .chip) { background:transparent; padding:0; margin:0 14px 4px 0; border-radius:0; font-size:14px }
  .prose :global(.chip.lic) { color:var(--ink); font-weight:500 }
  .prose :global(.rules) { padding:16px 20px; border-left-width:3px; border-radius:8px } .prose :global(.rules p) { margin:7px 0 0; font-size:14px }
  .prose :global(.rules-k) { font-size:12px; font-weight:600; color:var(--ink) }
  .prose :global(.files) { list-style:none; padding:0; margin:6px 0 }
  .prose :global(.files li) { padding:8px 0; border:0; line-height:1.5 }
  .prose :global(.files .fmeta) { color:var(--cp-text-muted); font-size:14px }
  .prose :global(.files small) { display:block; font-size:12.5px; color:var(--cp-text-muted); margin-top:2px }
  .prose :global(.files code) { font-size:11.5px; background:var(--cp-surface-soft); padding:1px 4px; border-radius:4px }
  .prose :global(.kit-tree-heading) { margin:24px 0 8px }
  .prose :global(.kit-tree-note) { margin:0 0 10px; font-size:14px; color:var(--ink2) }
  .prose :global(.kit-tree) { margin:0 0 24px; padding:16px 18px; max-width:100%; max-height:28rem; overflow:auto; overscroll-behavior:contain; border:1px solid var(--line); border-radius:8px; background:var(--cp-surface-soft); color:var(--ink); font:13px/1.7 Consolas,"Courier New",monospace; white-space:pre; scrollbar-width:thin }
  .prose :global(.kit-tree code) { padding:0; border-radius:0; background:transparent; font:inherit; white-space:pre; overflow-wrap:normal }
  .prose :global(.headsup li) { margin:8px 0 }
  .prose :global(.prompt) { border-radius:8px }
  .prose :global(details.presenter) { border-style:solid; border-color:var(--line) }
  .prose :global(.tier-meta) { font-size:14px; color:var(--ink2) }
  .prose :global(.tier-selector) { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:12px; margin:16px 0 24px }
  .prose :global(.tier-selector button) { text-align:left; display:flex; flex-direction:column; gap:6px; padding:16px; border:1px solid var(--line); border-radius:8px; background:var(--cp-surface); color:var(--ink); cursor:pointer; min-height:136px }
  .prose :global(.tier-selector button strong) { font-size:16px }
  .prose :global(.tier-selector button span) { font-size:13px; line-height:1.5; color:var(--ink2) }
  .prose :global(.tier-selector button small) { font-size:12px; color:var(--ink2); margin-top:auto }
  .prose :global(.tier-selector button[aria-selected="true"]) { border-color:var(--brand); box-shadow:inset 0 0 0 1px var(--brand); background:var(--brand-soft) }
  .prose :global(.tier-selector button:hover) { border-color:var(--brand) }
  .prose :global(.priority-grid) { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:10px; margin:16px 0 24px }
  .prose :global(.priority-grid > div) { padding:14px 16px; border:1px solid var(--line); border-radius:8px }
  .prose :global(.priority-grid strong), .prose :global(.priority-grid span) { display:block }
  .prose :global(.priority-grid span) { font-size:14px; color:var(--ink2); margin-top:4px }
  /* Steps */
  .prose :global(.stephead h4) { flex:1 }
  .prose :global(.done) { flex:none; border:1px solid var(--line); background:var(--cp-surface); color:var(--cp-text-muted); border-radius:6px; font-size:12px; padding:4px 10px; min-height:30px; cursor:pointer }
  .prose :global(.done[aria-pressed="true"]) { background:var(--cp-accent-soft); color:var(--brand); border-color:var(--brand); font-weight:600 }
  .prose :global(.stepcard.is-done .num) { background:var(--cp-success); color:var(--cp-surface) }
  .prose :global(.trouble) { font-size:13px; color:var(--cp-text-muted); margin:10px 0 0 } .prose :global(.trouble a) { color:var(--brand) }
  .prose :global(.routes) { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin:8px 0 18px }
  .prose :global(.route) { display:flex; flex-direction:column; gap:4px; border:1px solid var(--line); border-radius:8px; padding:14px 16px; text-decoration:none; color:var(--ink); background:transparent }
  .prose :global(.route:hover) { border-color:var(--brand) } .prose :global(.route span) { font-size:13.5px; color:var(--cp-text-muted) } .prose :global(.route em) { font-style:normal; font-size:13px; color:var(--brand) }
  /* Check it and fixes */
  .prose :global(.checklist) { list-style:none; padding:0 }
  .prose :global(.checklist li) { padding:9px 0 9px 28px; border:0; position:relative }
  .prose :global(.checklist .chk) { position:absolute; left:2px; top:10px; width:16px; height:16px; accent-color:var(--brand) }
  .prose :global(.fixes) { list-style:none; padding:0 } .prose :global(.fixes li) { padding:10px 0; border:0; scroll-margin-top:var(--scenario-anchor-offset, 104px) }
  .prose :global(.fixes li:target) { background:var(--brand-soft) }
  .prose :global(.steptag) { display:inline-block; font-size:11px; font-weight:700; color:var(--brand); background:var(--brand-soft); border-radius:5px; padding:1px 6px; vertical-align:1px }
