---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { label } from '../../lib/taxonomy';
import { isPublished } from '../../lib/publish';
import { existsSync, statSync } from 'node:fs';
import { join } from 'node:path';
import ToolIcon from '../../components/ToolIcon.astro';

export async function getStaticPaths() {
  const items = await getCollection('scenarios', (s) => isPublished(s.data.status));
  return items.map((s) => ({ params: { id: s.data.id }, props: { s } }));
}
const { s } = Astro.props;
const d = s.data;
const { Content, headings } = await render(s);
const stepsId = headings.find(heading => heading.text.toLowerCase() === 'steps')?.slug ?? 'scenario-steps';
const base = import.meta.env.BASE_URL;
const kitPath = join(process.cwd(), 'public', 'kits', `${d.id}.zip`);
const kit = existsSync(kitPath) ? { href: `${base}kits/${d.id}.zip`, kb: Math.round(statSync(kitPath).size / 1024) } : null;
---
<Base title={d.title.en}>
  <p class="crumb"><a id="back-to-results" href={`${base}?view=all`} data-base={base}>&larr; All scenarios</a> / {label('industry', d.industry[0])}</p>
  <div class="page">
    <article data-pagefind-body>
      <h1 data-pagefind-meta="title"><span data-l="en">{d.title.en}</span><span data-l="id">{d.title.id}</span><span data-l="ms">{d.title.ms}</span></h1>
      <div class="tags">
        <span class="chip lvl">{label('difficulty', d.difficulty)}</span>
        {d.industry.map((x) => <a class="chip" href={`${base}?industry=${x}`}>{label('industry', x)}</a>)}
        {d.department.map((x) => <a class="chip" href={`${base}?department=${x}`}>{label('department', x)}</a>)}
        {d.persona.map((x) => <a class="chip" href={`${base}?persona=${x}`}>{label('persona', x)}</a>)}
        {d.surface.map((x) => <a class="chip tool-chip" href={`${base}?surface=${x}`}><ToolIcon tool={x}/>{label('surface', x)}</a>)}
        {d.market.map((x) => <span class="chip">{label('market', x)}</span>)}
      </div>

      <section class="card60">
        <div class="k">In 60 seconds</div>
        <div class="grid60">
          <div><b>Problem</b><p>{d.card.problem}</p></div>
          <div><b>You get</b><p>{d.card.output}</p></div>
          <div><b>Time</b><p>{d.impact.baseline} → {d.impact.target}<br /><span class={`chip ev-${d.impact.evidence}`}>{label('evidence', d.impact.evidence)}</span></p></div>
        </div>
      </section>

      <div class="quick-start">
        {kit && <a class="start-kit" href={kit.href} download>&darr; Download demo kit <span>{kit.kb} KB</span></a>}
        <a class="start-go" href={`#${stepsId}`}>Start at step 1 <span aria-hidden="true">&darr;</span></a>
        <span class="start-note">Check the licence and the data rules before you begin.</span>
      </div>
      <div class="prose" id="scenario-steps"><Content /></div>
    </article>

    <aside class="side">
      {kit && (
        <a class="kit" href={kit.href} download>
          <strong>Download demo kit</strong>
          <span>Fictional files, answer key and setup notes · {kit.kb} KB</span>
        </a>
      )}
      <div class="box datarules">
        <div class="k">Data rules</div>
        <p><strong>Sensitivity:</strong> {d.data.sensitivity}</p>
        <p><strong>Sign-off:</strong> {d.data.signoff}</p>
        <p class="tenant">Work account only. Never a consumer AI tool.</p>
      </div>
      <nav class="onthispage" aria-labelledby="otp-h">
        <div class="k" id="otp-h">On this page</div>
        <ul>
          {headings.filter((h) => h.depth >= 2 && h.depth <= 4).map((h) => (
            <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </nav>
      <div class="box">
        <div class="k">Licence</div>
        {d.licence.map((x) => <span class="chip">{label('licence', x)}</span>)}
        <div class="k">Sources</div>
        {d.source_refs.map((u) => <p class="src"><a href={u}>{new URL(u).hostname}</a></p>)}
      </div>
    </aside>
  </div>
</Base>

<script>
  const back = document.getElementById('back-to-results');
  const query = new URLSearchParams(location.search).get('library');
  if (back instanceof HTMLAnchorElement && query) {
    const params = new URLSearchParams(query);
    back.href = `${back.dataset.base}?${params}`;
    back.textContent = params.get('view') === 'recommended' ? '\u2190 Back to your suggestions' : '\u2190 Back to results';
  }
</script>

<style>
  .crumb { font-size:13px; color:var(--ink2); margin:0 0 8px }
  .kit { display:block; margin-bottom:14px; padding:16px; border-radius:12px; background:var(--brand); color:var(--cp-accent-fg); text-decoration:none }
  .kit:hover { background:var(--cp-accent-hover) } .kit strong { display:block; font-size:15px } .kit span { font-size:12.5px; opacity:.9 }
  .page { display:grid; grid-template-columns:1fr 260px; gap:28px; align-items:start }
  article { background:var(--cp-surface); border:1px solid var(--line); border-radius:16px; padding:28px 32px; min-width:0 }
  h1 { margin:0 0 16px; font-size:32px; line-height:1.2; letter-spacing:-.025em; font-weight:600 }
  .tags a.chip { text-decoration:none } .tags a.chip:hover { background:var(--cp-accent-soft); color:var(--cp-accent) }
  .card60 { margin:24px 0 8px; background:var(--brand-soft); border:1px solid var(--cp-border); border-radius:10px; padding:14px 18px }
  .grid60 { display:grid; grid-template-columns:1fr 1.3fr .9fr; gap:18px } .grid60 p { margin:2px 0 0; font-size:14px }
  .k { font-size:11.5px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--ink2); margin:10px 0 3px }
  .card60 > .k { margin-top:0; color:var(--brand) }
  .prose :global(h2) { font-size:24px; margin:34px 0 10px; padding-top:10px; border-top:1px solid var(--line); letter-spacing:-.015em }
  .prose :global(h3) { font-size:19px; margin:26px 0 8px } .prose :global(h4) { font-size:17px; margin:0 }
  /* Keep running text at a readable measure; cards and tables use the full column. */
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(.callout) { max-width:68ch }
  .prose :global(.stepcard) { max-width:none; border:1px solid var(--line); border-radius:12px; background:var(--cp-surface); padding:16px 18px; margin:0 0 16px }
  .prose :global(.stephead) { display:flex; align-items:flex-start; gap:11px; margin-bottom:10px }
  .prose :global(.stephead .num) { flex:none; width:28px; height:28px; border-radius:50%; background:var(--brand); color:var(--cp-accent-fg); font-weight:700; font-size:15px; line-height:28px; text-align:center }
  .prose :global(.stepcard > p:last-child) { margin-bottom:0 }
  .prose :global(.after-run) { background:var(--cp-accent-soft); border-left:3px solid var(--cp-success); border-radius:6px; padding:9px 12px; margin:8px 0 0 }
  .prose :global(h3.part) { padding-top:8px; border-top:1px solid var(--line); color:var(--brand) }
  .prose :global(.part-note) { margin-top:-4px; color:var(--cp-text-muted) }
  .side { position:sticky; top:104px; display:flex; flex-direction:column; gap:14px }
  .box { background:var(--cp-surface); border:1px solid var(--line); border-radius:12px; padding:6px 16px 12px }
  .datarules { border-left:4px solid var(--warnline) } .datarules .k { color:var(--warnline) } .datarules .tenant { margin-top:4px; font-weight:600 }
  .onthispage { background:var(--cp-surface); border:1px solid var(--line); border-radius:12px; padding:10px 14px; min-height:0 }
  /* The list scrolls, not the whole rail, so the data rules stay pinned next to the prompts. */
  .onthispage ul { list-style:none; margin:0; padding:0; font-size:13.5px; max-height:min(46vh, 420px); overflow:auto; scrollbar-width:thin }
  .onthispage li { padding:3px 0 } .onthispage a { text-decoration:none; color:var(--cp-text-muted) }
  .onthispage a:hover { color:var(--cp-accent); text-decoration:underline }
  .onthispage .d2 > a { font-weight:600; color:var(--ink) } .onthispage .d3 { padding-left:10px } .onthispage .d4 { padding-left:20px; font-size:13px }
  .box p { margin:0; font-size:14px } .src { font-size:13px !important; overflow-wrap:anywhere }
  .quick-start { display:flex; align-items:center; gap:12px; margin:20px 0; font-size:13px; flex-wrap:wrap; padding:14px 16px; background:var(--cp-bg-elevated); border:1px solid var(--line); border-radius:12px }
  .start-kit, .start-go { display:inline-flex; align-items:center; gap:8px; text-decoration:none; border-radius:8px; padding:10px 16px; font-size:15px; font-weight:600; min-height:44px; border:1px solid transparent }
  .start-kit { background:var(--brand); color:var(--cp-accent-fg) } .start-kit:hover { background:var(--cp-accent-hover) } .start-kit span { font-weight:400; font-size:12px; opacity:.85 }
  .start-go { background:var(--cp-surface); color:var(--brand); border-color:var(--line) } .start-go:hover { border-color:var(--cp-border-strong) }
  .start-note { color:var(--cp-text-muted) }
  .prose { overflow-wrap:anywhere; scroll-margin-top:104px }
  .prose :global(table) { display:block; max-width:100%; overflow:auto }
  .prose :global(img) { max-width:100%; height:auto }
  .prose :global(pre) { max-width:100%; overflow:auto }
  .prose :global(h2), .prose :global(h3), .prose :global(h4) { scroll-margin-top:104px }
  .prose :global(.stepcard) { scroll-margin-top:104px }
  @media print {
    .quick-start, .side, .crumb { display:none }
    .page { display:block } article { border:0; padding:0 }
    /* A printed prompt must show every line, not a scroll window. */
    .prose :global(.plines) { max-height:none !important; overflow:visible !important }
    .prose :global(.stepcard) { break-inside:avoid; border-color:#999 }
  }
  @media(max-width:850px) { .page { grid-template-columns:1fr } .side { position:static; grid-row:2; max-height:none; overflow:visible } .kit { margin-bottom:12px } article { padding:24px } .grid60 { grid-template-columns:1fr } }
  @media(max-width:640px) { article { padding:20px 16px } h1 { font-size:26px } .crumb { margin-bottom:16px } }
</style>
