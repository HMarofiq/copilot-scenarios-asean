---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { label } from '../../lib/taxonomy';
import { isPublished } from '../../lib/publish';
import { existsSync, statSync } from 'node:fs';
import { join } from 'node:path';
import ToolIcon from '../../components/ToolIcon.astro';

export async function getStaticPaths() {
  const items = await getCollection('scenarios', (s) => isPublished(s.data.status));
  return items.map((s) => ({ params: { id: s.data.id }, props: { s } }));
}
const { s } = Astro.props;
const d = s.data;
const { Content, headings } = await render(s);
const stepsId = headings.find(heading => heading.text.toLowerCase() === 'steps')?.slug ?? 'scenario-steps';
const base = import.meta.env.BASE_URL;
const kitPath = join(process.cwd(), 'public', 'kits', `${d.id}.zip`);
const kit = existsSync(kitPath) ? { href: `${base}kits/${d.id}.zip`, kb: Math.round(statSync(kitPath).size / 1024) } : null;
---
<Base title={d.title.en}>
  <p class="crumb"><a id="back-to-results" href={`${base}?view=all`} data-base={base}>&larr; All scenarios</a> / {label('industry', d.industry[0])}</p>
  <div class="page">
    <article data-pagefind-body>
      <h1 data-pagefind-meta="title"><span data-l="en">{d.title.en}</span><span data-l="id">{d.title.id}</span><span data-l="ms">{d.title.ms}</span></h1>
      <div class="tags">
        <span class="chip lvl">{label('difficulty', d.difficulty)}</span>
        {d.industry.map((x) => <a class="chip" href={`${base}?industry=${x}`}>{label('industry', x)}</a>)}
        {d.department.map((x) => <a class="chip" href={`${base}?department=${x}`}>{label('department', x)}</a>)}
        {d.persona.map((x) => <a class="chip" href={`${base}?persona=${x}`}>{label('persona', x)}</a>)}
        {d.surface.map((x) => <a class="chip tool-chip" href={`${base}?surface=${x}`}><ToolIcon tool={x}/>{label('surface', x)}</a>)}
        {d.market.map((x) => <span class="chip">{label('market', x)}</span>)}
      </div>

      <section class="card60">
        <div class="k">In 60 seconds</div>
        <div class="grid60">
          <div><b>Problem</b><p>{d.card.problem}</p></div>
          <div><b>You get</b><p>{d.card.output}</p></div>
          <div><b>Time</b><p>{d.impact.baseline} → {d.impact.target}<br /><span class={`chip ev-${d.impact.evidence}`}>{label('evidence', d.impact.evidence)}</span></p></div>
        </div>
      </section>

      <div class="quick-start"><a href={`#${stepsId}`}>Go to steps &amp; prompts <span aria-hidden="true">&darr;</span></a><span>Check the required licence and inputs before you begin.</span></div>
      <div class="prose" id="scenario-steps"><Content /></div>
    </article>

    <aside class="side">
      {kit && (
        <a class="kit" href={kit.href} download>
          <strong>Download demo kit</strong>
          <span>Fictional files, answer key and setup notes · {kit.kb} KB</span>
        </a>
      )}
      <div class="box">
        <div class="k">Licence</div>
        {d.licence.map((x) => <span class="chip">{label('licence', x)}</span>)}
        <div class="k">Sensitivity</div><p>{d.data.sensitivity}</p>
        <div class="k">Sign-off</div><p>{d.data.signoff}</p>
        <div class="k">Sources</div>
        {d.source_refs.map((u) => <p class="src"><a href={u}>{new URL(u).hostname}</a></p>)}
      </div>
    </aside>
  </div>
</Base>

<script>
  const back = document.getElementById('back-to-results');
  const query = new URLSearchParams(location.search).get('library');
  if (back instanceof HTMLAnchorElement && query) {
    const params = new URLSearchParams(query);
    back.href = `${back.dataset.base}?${params}`;
    back.textContent = params.get('view') === 'recommended' ? '\u2190 Back to your suggestions' : '\u2190 Back to results';
  }
</script>

<style>
  .crumb { font-size:13px; color:var(--ink2); margin:0 0 8px }
  .kit { display:block; margin-bottom:14px; padding:16px; border-radius:12px; background:var(--brand); color:var(--cp-accent-fg); text-decoration:none }
  .kit:hover { background:var(--cp-accent-hover) } .kit strong { display:block; font-size:15px } .kit span { font-size:12.5px; opacity:.9 }
  .page { display:grid; grid-template-columns:1fr 260px; gap:28px; align-items:start }
  article { background:var(--cp-surface); border:1px solid var(--line); border-radius:16px; padding:28px 32px; min-width:0 }
  h1 { margin:0 0 16px; font-size:32px; line-height:1.2; letter-spacing:-.025em; font-weight:600 }
  .tags a.chip { text-decoration:none } .tags a.chip:hover { background:var(--cp-accent-soft); color:var(--cp-accent) }
  .card60 { margin:24px 0 8px; background:var(--brand-soft); border:1px solid var(--cp-border); border-radius:10px; padding:14px 18px }
  .grid60 { display:grid; grid-template-columns:1fr 1.3fr .9fr; gap:18px } .grid60 p { margin:2px 0 0; font-size:14px }
  .k { font-size:11.5px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--ink2); margin:10px 0 3px }
  .card60 > .k { margin-top:0; color:var(--brand) }
  .prose :global(h2) { font-size:19px; margin:26px 0 8px; padding-top:6px; border-top:1px solid var(--line) }
  .side { position:sticky; top:104px } .box { background:var(--cp-surface); border:1px solid var(--line); border-radius:12px; padding:6px 16px 12px }
  .box p { margin:0; font-size:14px } .src { font-size:13px !important; overflow-wrap:anywhere }
  .quick-start { display:flex; align-items:center; gap:20px; margin:20px 0; font-size:13px; flex-wrap:wrap } .quick-start a { font-weight:600 } .quick-start span { color:var(--cp-text-muted) }
  .prose { overflow-wrap:anywhere; scroll-margin-top:104px }
  .prose :global(table) { display:block; max-width:100%; overflow:auto }
  .prose :global(img) { max-width:100%; height:auto }
  .prose :global(pre) { max-width:100%; overflow:auto }
  .prose :global(h2) { scroll-margin-top:104px }
  @media(max-width:850px) { .page { grid-template-columns:1fr } .side { position:static; grid-row:1 } .kit { margin-bottom:12px } article { padding:24px } .grid60 { grid-template-columns:1fr } }
  @media(max-width:640px) { article { padding:20px 16px } h1 { font-size:26px } .crumb { margin-bottom:16px } }
</style>
