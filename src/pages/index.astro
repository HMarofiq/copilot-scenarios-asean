---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { FACETS, FACET_TITLES, label, taxonomy } from '../lib/taxonomy';
import { isPublished } from '../lib/publish';
import { ROLES, GUIDE_ENABLED } from '../lib/discovery.mjs';
import ToolIcon from '../components/ToolIcon.astro';

const base = import.meta.env.BASE_URL;
const items = (await getCollection('scenarios', (s) => isPublished(s.data.status, s.data.publish_draft))).sort((a, b) => a.data.id.localeCompare(b.data.id));
const valuesOf = (s: (typeof items)[number], f: typeof FACETS[number]): string[] => {
  if (f === 'evidence') return [s.data.impact.evidence];
  if (f === 'difficulty') return [String(s.data.difficulty)];
  return s.data[f];
};
const facetValues = Object.fromEntries(FACETS.map(f => [f, [...new Set(items.flatMap(s => valuesOf(s, f)))].sort()]));
const choices = Object.fromEntries(FACETS.map(f => [f, Object.keys(taxonomy[f])]));
const labels = Object.fromEntries(FACETS.map(f => [f, Object.fromEntries(Object.keys(taxonomy[f]).map(v => [v, label(f, v)]))]));
const tools = ['outlook', 'teams', 'word', 'excel', 'powerpoint', 'copilot-chat', 'agent', 'cowork', 'scout'];
const data = items.map(s => ({
  id: s.data.id,
  text: [...Object.values(s.data.title), ...Object.values(s.data.summary), s.data.card.problem, s.data.card.output].join(' ').toLowerCase(),
  ...Object.fromEntries(FACETS.map(f => [f, valuesOf(s, f)])),
}));
---
<Base title="Find your next Copilot scenario">
  <div id="discovery" data-base={base} data-choices={JSON.stringify(choices)} data-labels={JSON.stringify(labels)} data-scenarios={JSON.stringify(data)} data-dev={import.meta.env.DEV}>
    <section data-view="home" class="welcome">
      <div class="eyebrow"><span class="eyebrow-line"></span> PRACTICAL AI, EVERYDAY WORK</div>
      <h1 tabindex="-1">Your work.<br />A little more <span>possible.</span></h1>
      <p class="welcome-copy">Find practical ways Copilot, Cowork and Scout can help.<br class="desktop-break" /> {GUIDE_ENABLED ? 'Start with your role, or take a look around.' : 'Browse the library and filter by the work you do.'}</p>
      <div class="entry-grid">
        {GUIDE_ENABLED ? (
        <a href="?view=guide" class="entry-card entry-primary" data-route="guide">
          <div class="entry-top"><span class="entry-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="16" cy="10" r="5"/><path d="M6 28v-4a10 10 0 0 1 20 0v4M24 6h6M27 3v6"/></svg></span><span class="entry-tag">GUIDED DISCOVERY</span></div>
          <h2>Start with my persona</h2>
          <p>A few quick questions about your role, department and tools. Find a useful place to start.</p>
          <span class="entry-cta">Find scenarios for me <span aria-hidden="true">&rarr;</span></span>
          <span class="entry-note">3 questions. Skip any you like.</span>
        </a>
        ) : (
        <div class="entry-card entry-soon" aria-disabled="true">
          <div class="entry-top"><span class="entry-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="16" cy="10" r="5"/><path d="M6 28v-4a10 10 0 0 1 20 0v4M24 6h6M27 3v6"/></svg></span><span class="entry-tag soon-badge">COMING SOON</span></div>
          <h2>Start with my persona</h2>
          <p>A few quick questions about your role, department and tools. Find a useful place to start.</p>
          <span class="entry-cta">Coming soon</span>
          <span class="entry-note">We are adding more scenarios for each role first.</span>
        </div>
        )}
        <a href="?view=all" class:list={['entry-card', !GUIDE_ENABLED && 'entry-primary']} data-route="all">
          <div class="entry-top"><span class="entry-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="4" width="10" height="10" rx="2"/><rect x="18" y="4" width="10" height="10" rx="2"/><rect x="4" y="18" width="10" height="10" rx="2"/><rect x="18" y="18" width="10" height="10" rx="2"/></svg></span><span class="entry-tag">EXPLORE AT YOUR PACE</span></div>
          <h2>Explore all scenarios</h2>
          <p>Have something in mind? Search the library and filter by the work you want to do.</p>
          <span class="entry-cta">Browse all scenarios <span aria-hidden="true">&rarr;</span></span>
          <span class="entry-note">Go straight to the full library.</span>
        </a>
      </div>
      <div class="welcome-foot"><span>No sign-in to browse</span><span>Step-by-step guides</span><span>Prompts in EN, ID &amp; BM</span></div>
    </section>

    <section data-view="guide" class="guide" hidden aria-label="Find scenarios for your persona">
      <div class="guide-nav"><button type="button" id="guide-back" class="text-button">&larr; Back</button><a href="?view=all" data-route="all">Browse all scenarios instead</a></div>
      <div class="step-label" id="step-label">STEP 1 OF 3</div>
      <ol class="stepper" aria-label="Your progress">
        <li data-step-marker="1"><span>1</span> Your role</li><li data-step-marker="2"><span>2</span> Department</li><li data-step-marker="3"><span>3</span> Everyday tools</li>
      </ol>
      <form id="guide-form">
        <fieldset data-step="1">
          <legend tabindex="-1">Which best describes your role?</legend>
          <p class="question-hint">Choose the closest fit. It does not need to match your job title.</p>
          <div class="answer-grid role-grid">
            {ROLES.map(role => <label class="answer"><input type="radio" name="role" value={role.id}/><span><strong>{role.title}</strong><small>{role.description}</small></span></label>)}
            <label class="answer"><input type="radio" name="role" value=""/><span><strong>Something else / Not sure</strong><small>Discover possibilities across different roles.</small></span></label>
          </div>
        </fieldset>
        <fieldset data-step="2" hidden>
          <legend tabindex="-1">Which area do you work in?</legend>
          <p class="question-hint">Select any that apply. Work across teams? You can choose more than one.</p>
          <div class="answer-grid compact-grid">
            {Object.keys(taxonomy.department).sort((a,b) => label('department', a).localeCompare(label('department', b))).map(value => <label class="answer"><input type="checkbox" name="departments" value={value}/><span>{label('department', value)}</span></label>)}
          </div>
          <p class="question-hint">Your area is not listed? Skip this question to keep your options open.</p>
        </fieldset>
        <fieldset data-step="3" hidden>
          <legend tabindex="-1">Which tools do you use regularly?</legend>
          <p class="question-hint">Select any that apply. We will prioritise familiar tools, not limit what you can discover.</p>
          <div class="answer-grid compact-grid">
            {tools.map(value => <label class="answer"><input type="checkbox" name="tools" value={value}/><span class="tool-label"><ToolIcon tool={value}/>{label('surface', value)}</span></label>)}
          </div>
          <p class="question-hint">Use other tools, or not sure? Skip this question. App use does not tell us your Copilot licence.</p>
        </fieldset>
        <div class="guide-actions"><button type="submit" class="button primary" id="continue">Continue <span aria-hidden="true">&rarr;</span></button><button type="button" class="text-button" id="skip-question">Skip this question</button><button type="button" class="text-button early-results" id="show-now">Show suggestions now</button></div>
      </form>
      <p class="privacy-note">No account or personal details needed. Your choices stay in this browser URL unless you share it.</p>
    </section>

    <section data-view="library" hidden>
      <div class="library-top"><a href={base} data-route="home" class="back-link">&larr; Start</a><button type="button" id="edit-persona" class="text-button" hidden={!GUIDE_ENABLED}>Find scenarios for my persona</button></div>
      <div class="library-heading"><div><div class="eyebrow" id="results-eyebrow">THE SCENARIO LIBRARY</div><h1 id="results-title" tabindex="-1">Explore all scenarios</h1><p id="results-description">Find a practical starting point for the work in front of you.</p></div><span class="library-total">{items.length}<small>scenarios to explore</small></span></div>
      <div id="persona-summary" class="persona-summary" hidden><div><strong>Your starting point</strong><div id="persona-chips"></div></div><button type="button" id="change-answers" class="text-button">Change answers</button></div>
      <div class="search-row"><label class="search-box"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span class="sr-only">Search scenarios</span><input id="q" type="search" placeholder="What would you like help with? Try budget, meeting or report..." autocomplete="off"/></label><button type="button" class="button" id="clear">Clear filters</button></div>
      <p id="search-note" class="search-note" role="status" hidden></p>
      <div class="library-layout">
        <aside class="filter-panel" aria-label="Scenario filters">
          <details class="filter-disclosure" open>
            <summary>Refine your results <span aria-hidden="true">+</span></summary>
            <div class="filter-content">
              {['department', 'surface'].map(f => <fieldset data-facet={f}><legend>{f === 'surface' ? 'Apps & tools' : FACET_TITLES[f]}</legend>{facetValues[f].map(v => <label><input type="checkbox" value={v}/><span class:list={{'tool-label': f === 'surface'}}>{f === 'surface' && <ToolIcon tool={v}/>}<span>{label(f, v)}</span></span><em class="n"></em></label>)}</fieldset>)}
              <details class="more-filters"><summary>More filters</summary>
                {FACETS.filter(f => !['department', 'surface'].includes(f)).map(f => <fieldset data-facet={f}><legend>{FACET_TITLES[f]}</legend>{facetValues[f].map(v => <label><input type="checkbox" value={v}/><span>{label(f, v)}</span><em class="n"></em></label>)}</fieldset>)}
              </details>
            </div>
          </details>
        </aside>
        <div class="results">
          <div id="active-filters" class="active-filters" aria-label="Selected filters"></div>
          <div class="results-toolbar"><p id="result-count" role="status" aria-live="polite" tabindex="-1"></p><span id="sort-label">Browse the library</span></div>
          <div class="scenario-grid" id="scenario-grid">
            {items.map(s => {
              const d = s.data;
              return <a class="scenario-card" href={`${base}scenarios/${d.id}/`} data-id={d.id}>
                <div class="card-top"><span class="chip lvl">{label('difficulty', d.difficulty)}</span><span class="card-industry">{label('industry', d.industry[0])}</span></div>
                <h2><span data-l="en">{d.title.en}</span><span data-l="id">{d.title.id}</span><span data-l="ms">{d.title.ms}</span></h2>
                {d.status === 'draft' && <span class="draft-label">Draft · not fully validated</span>}
                <p class="card-summary"><span data-l="en">{d.summary.en}</span><span data-l="id">{d.summary.id}</span><span data-l="ms">{d.summary.ms}</span></p>
                <div class="card-output"><span>YOU GET</span><p>{d.card.output}</p></div>
                <p class="match-reason" hidden></p>
                <div class="card-tools">{d.surface.map(x => <span class="chip tool-chip"><ToolIcon tool={x}/>{label('surface', x)}</span>)}</div>
                <p class="card-licence"><strong>Requires:</strong> {d.licence.map(x => label('licence', x)).join(' + ')}</p>
                <div class="card-bottom"><span>View steps &amp; prompts</span><span aria-hidden="true">&rarr;</span></div>
              </a>;
            })}
          </div>
          <div id="empty" class="empty-state" hidden><h2>No scenarios match these filters</h2><p>Try a broader search or clear your filters. Your persona answers will stay in place.</p><button type="button" class="button" id="empty-clear">Clear filters and search</button></div>
          <button type="button" class="button show-more" id="show-more" hidden>See more suggestions</button>
          <p class="results-note">Recommendations reflect your selections, not verified access. Check the licence, inputs and setup steps before trying a scenario.</p>
        </div>
      </div>
    </section>
  </div>
  <noscript><p>Enable JavaScript for guided discovery and filtering, or open a scenario directly:</p><ul>{items.map(s => <li><a href={`${base}scenarios/${s.data.id}/`}>{s.data.title.en}</a></li>)}</ul></noscript>
</Base>

<script>
  import '../scripts/discovery.js';
</script>

<style>
  .eyebrow { display:flex; align-items:center; gap:10px; color:var(--cp-accent); font-size:11px; letter-spacing:.16em; font-weight:700 }
  .eyebrow-line { width:28px; height:2px; background:var(--cp-accent) }
  .welcome { max-width:960px; margin:32px auto 0 }
  .welcome h1 { font-size:clamp(42px,5.2vw,68px); letter-spacing:-.05em; font-weight:600; line-height:1.08; margin:24px 0 }
  .welcome h1 span { color:var(--cp-accent) }
  .welcome-copy { color:var(--cp-text-muted); font-size:19px; line-height:1.6; margin:0 0 36px }
  .entry-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px }
  .entry-card { display:flex; flex-direction:column; padding:28px; border:1px solid var(--cp-border); background:var(--cp-surface); border-radius:16px; text-decoration:none; color:var(--cp-text); transition:border-color .15s,transform .15s }
  .entry-card:hover { border-color:var(--cp-accent); transform:translateY(-3px) }
  .entry-primary { border-color:var(--cp-accent); background:var(--cp-bg-elevated) }
  .entry-top { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:24px }
  .entry-icon { display:grid; place-items:center; background:var(--cp-accent-soft); color:var(--cp-accent); width:48px; height:48px; border-radius:10px } .entry-icon svg { width:28px; height:28px }
  .entry-tag { font-size:10px; letter-spacing:.1em; font-weight:600; color:var(--cp-text-muted) }
  .entry-card h2 { margin:0 0 10px; font-size:24px; letter-spacing:-.025em }
  .entry-card p { margin:0 0 28px; font-size:15px; color:var(--cp-text-muted); max-width:350px }
  .entry-cta { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-top:auto; font-weight:600; min-height:48px; color:var(--cp-accent) }
  .entry-primary .entry-cta { background:var(--cp-accent); color:var(--cp-accent-fg); border-radius:10px; padding:12px 16px }
  .entry-cta > span { font-size:22px; line-height:1 }
  .entry-note { font-size:12px; color:var(--cp-text-muted); margin-top:12px }
  .entry-soon { cursor:default; opacity:.72 } .entry-soon:hover { border-color:var(--cp-border); transform:none }
  .entry-soon .entry-cta { border:1px dashed var(--cp-border); border-radius:10px; padding:12px 16px; color:var(--cp-text-muted) }
  .soon-badge { background:var(--cp-accent-soft); color:var(--cp-accent); padding:4px 8px; border-radius:999px }
  .welcome-foot { display:flex; flex-wrap:wrap; gap:12px 28px; padding:28px 0 8px; font-size:12px; color:var(--cp-text-muted) } .welcome-foot span::before { content:'\2713'; color:var(--cp-accent); margin-right:8px }
  .button { display:inline-flex; justify-content:center; align-items:center; gap:24px; padding:12px 20px; min-height:46px; border-radius:10px; border:1px solid var(--cp-border); background:var(--cp-surface); color:var(--cp-text); font-weight:600; cursor:pointer }
  .button:hover { border-color:var(--cp-accent) } .button.primary { background:var(--cp-accent); color:var(--cp-accent-fg); border-color:var(--cp-accent) } .button.primary:hover { background:var(--cp-accent-hover) }
  .text-button { background:none; border:0; color:var(--cp-accent); cursor:pointer; padding:10px 0; font-size:14px; min-height:44px; text-align:left }
  .text-button:hover, .back-link:hover { text-decoration:underline }
  .guide { max-width:840px; margin:0 auto } .guide-nav { display:flex; justify-content:space-between; align-items:center; gap:20px; margin-bottom:32px } .guide-nav a { font-size:13px; color:var(--cp-text-muted) }
  .step-label { color:var(--cp-accent); font-size:11px; letter-spacing:.12em; font-weight:700 }
  .stepper { display:flex; list-style:none; padding:0; gap:28px; margin:16px 0 36px; font-size:13px; color:var(--cp-text-muted) }
  .stepper li { display:flex; align-items:center; gap:8px } .stepper span { border:1px solid var(--cp-border-strong); border-radius:50%; width:26px; height:26px; display:grid; place-items:center; font-size:12px }
  .stepper [aria-current="step"] { color:var(--cp-accent); font-weight:600 } .stepper [aria-current="step"] span { background:var(--cp-accent); color:var(--cp-accent-fg); border-color:var(--cp-accent) }
  .guide fieldset { border:0; padding:0; margin:0; min-width:0 }
  .guide legend { font-size:clamp(26px,3vw,34px); line-height:1.2; letter-spacing:-.03em; font-weight:600; padding:0; max-width:100% }
  .question-hint { color:var(--cp-text-muted); margin:12px 0 24px }
  .answer-grid { display:grid; gap:12px } .role-grid { grid-template-columns:1fr 1fr } .compact-grid { grid-template-columns:repeat(3,1fr) }
  .answer { display:flex; align-items:flex-start; gap:12px; padding:18px; background:var(--cp-surface); border:1px solid var(--cp-border); border-radius:10px; cursor:pointer; transition:border-color .15s }
  .answer:hover { border-color:var(--cp-border-strong) } .answer:has(input:checked) { background:var(--cp-accent-soft); border-color:var(--cp-accent) } .answer:has(input:focus-visible) { outline:3px solid var(--cp-accent); outline-offset:3px }
  .answer input { width:18px; height:18px; margin:3px 0 0; flex-shrink:0 } .answer strong { display:block; font-size:15px; font-weight:600 } .answer small { display:block; color:var(--cp-text-muted); margin-top:5px; line-height:1.5; font-size:13px } .compact-grid .answer { padding:14px; align-items:center; font-size:14px; min-height:56px }
  .guide-actions { display:flex; align-items:center; gap:24px; border-top:1px solid var(--cp-border); margin-top:32px; padding-top:24px } .early-results { margin-left:auto }
  .privacy-note { color:var(--cp-text-muted); font-size:12px; margin-top:24px }
  .library-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:24px } .back-link { color:var(--cp-text-muted); font-size:14px; text-decoration:none }
  .library-heading { display:flex; align-items:center; justify-content:space-between; gap:32px; margin-bottom:24px } .library-heading h1 { margin:8px 0; font-size:36px; letter-spacing:-.035em; font-weight:600; line-height:1.2 } .library-heading p { margin:0; color:var(--cp-text-muted); max-width:740px }
  .library-total { font-size:36px; color:var(--cp-accent); font-weight:600; line-height:1.2; text-align:right; flex-shrink:0 } .library-total small { display:block; font-size:11px; color:var(--cp-text-muted); font-weight:400; margin-top:4px }
  .persona-summary { display:flex; justify-content:space-between; gap:20px; align-items:center; border:1px solid var(--cp-border); background:var(--cp-bg-elevated); border-radius:10px; padding:16px 20px; margin-bottom:24px } .persona-summary strong { font-size:12px; display:block; margin-bottom:8px } .persona-summary .text-button { flex-shrink:0 }
  .search-row { display:flex; gap:12px; margin-bottom:24px } .search-box { display:flex; align-items:center; gap:12px; background:var(--cp-surface); border:1px solid var(--cp-border-strong); border-radius:10px; padding:0 16px; flex:1; color:var(--cp-text-muted); min-width:0 } .search-box:focus-within { outline:2px solid var(--cp-accent); outline-offset:2px } .search-box svg { flex-shrink:0 } .search-box input { background:none; border:0; color:var(--cp-text); width:100%; min-width:0; padding:14px 0; outline:none } .search-box input::placeholder { color:var(--cp-text-muted) }
  .search-note { font-size:13px; color:var(--cp-text-muted); margin-top:-12px }
  .library-layout { display:grid; grid-template-columns:224px minmax(0,1fr); gap:28px; align-items:start }
  .filter-panel { border:1px solid var(--cp-border); background:var(--cp-surface); border-radius:12px; padding:16px; position:sticky; top:104px; max-height:calc(100vh - 128px); overflow:auto }
  .filter-disclosure > summary { font-weight:600; font-size:14px; cursor:pointer; list-style:none; display:flex; justify-content:space-between; gap:8px }
  .filter-disclosure[open] > summary > span { display:none }
  .filter-content fieldset { border:0; border-top:1px solid var(--cp-border); padding:14px 0 12px; margin:20px 0 0; min-width:0 } .filter-content legend { font-size:12px; font-weight:600; padding:0 8px 0 0 }
  .filter-content label { display:flex; gap:8px; align-items:center; cursor:pointer; font-size:13px; min-height:32px; padding:4px 0 } .filter-content label > span { flex:1 } .filter-content input { width:16px; height:16px; margin:0; flex-shrink:0 } .filter-content em { font-style:normal; font-size:11px; color:var(--cp-text-muted) } .filter-content .zero { color:var(--cp-text-muted) }
  .more-filters > summary { cursor:pointer; font-size:13px; color:var(--cp-accent); padding:12px 0; border-top:1px solid var(--cp-border) }
  .results-toolbar { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:16px; color:var(--cp-text-muted); font-size:13px } .results-toolbar p { margin:0 } #sort-label { font-size:12px }
  .active-filters { display:flex; flex-wrap:wrap; gap:8px } .active-filters:not(:empty) { margin-bottom:16px }
  .active-filters :global(button) { border:1px solid var(--cp-border); border-radius:6px; background:var(--cp-surface); color:var(--cp-text); cursor:pointer; padding:6px 10px; font-size:12px; min-height:32px }
  .scenario-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px }
  .scenario-card { display:flex; flex-direction:column; gap:14px; background:var(--cp-surface); color:var(--cp-text); text-decoration:none; padding:24px; border:1px solid var(--cp-border); border-radius:16px; transition:border-color .15s; min-width:0; overflow-wrap:anywhere }
  .scenario-card:hover { border-color:var(--cp-accent) } .card-top { display:flex; align-items:flex-start; gap:8px; justify-content:space-between } .card-industry { color:var(--cp-text-muted); font-size:11px; text-align:right } .card-top .chip { flex-shrink:0; font-size:11px; margin:0 }
  .scenario-card h2 { font-size:20px; letter-spacing:-.02em; line-height:1.35; margin:0; font-weight:600 } .card-summary { color:var(--cp-text-muted); font-size:14px; margin:0 }
  .card-output { background:var(--cp-bg-elevated); border-radius:8px; padding:12px } .card-output > span { font-size:10px; font-weight:700; letter-spacing:.1em; color:var(--cp-text-muted) } .card-output p { margin:4px 0 0; font-size:13px }
  .draft-label { font-size:12px; color:var(--cp-text-muted); font-weight:600 }
